#!/usr/bin/env bash

rp() {
	local color=${1:-1}

	{
		awk '
		/\[PACMAN\] Running .*pacman/ { print; next }
		/\[ALPM\] (installed|removed|upgraded) / && !/\[ALPM-SCRIPTLET\]/ { print }
		' /var/log/pacman.log |
		sed -E 's/T([0-9]{2}:[0-9]{2}:[0-9]{2})\+[0-9]{4}/ \1/' |
		sed -E \
		-e 's/\[PACMAN\] Running/---/' \
		-e 's/\[ALPM\] upgraded / = /' \
		-e 's/\[ALPM\] installed / + /' \
		-e 's/\[ALPM\] removed / - /'

		awk '
		/Command:/ || /INFO \[STANDARD\]: (Installing|Removing|Upgrading) package:/ { print }
		' /var/log/shelly.log |
		perl -MTime::Local -pe '
			if (/^\[([0-9]+)\]/) {
				$e = $1;
				($s,$min,$h,$day,$m,$y) = localtime($e);
				$y += 1900;
				$m++;
				s/^\[[^]]+\]/sprintf("[%04d-%02d-%02d %02d:%02d:%02d]",$y,$m,$day,$h,$min,$s)/e;
			}
			elsif (/^\[([^]]+)Z\]/) {
				($d,$t)=split("T",$1);
				($y,$m,$day)=split("-",$d);
				($h,$min,$s)=split(":",$t);
				$e=timegm($s,$min,$h,$day,$m-1,$y);
				($s,$min,$h,$day,$m,$y)=localtime($e);
				$y += 1900;
				$m++;
				s/^\[[^]]+\]/sprintf("[%04d-%02d-%02d %02d:%02d:%02d]",$y,$m,$day,$h,$min,$s)/e;
			}
		' |
		sed -E \
		-e 's/^(.*)INFO \[STANDARD\]: Installing package: (.+)$/\1 + \2/' \
		-e 's/^(.*)INFO \[STANDARD\]: Removing package: (.+)$/\1 - \2/' \
		-e 's/^(.*)INFO \[STANDARD\]: Upgrading package: (.+) -> (.+)$/\1 = \2 -> \3/' \
		-e "s/Command: /--- '/" \
		-e "/--- '/ s/$/'/" \
		-e 's/^(\[[^]]+\])[[:space:]]+= ([^ ]+) ([^ ]+) -> ([^ ]+)$/\1 = \2 (\3 -> \4)/' \
		-e 's/^(\[[^]]+\])[[:space:]]+(\+|-) (.*) ([^ ]+)$/\1 \2 \3 (\4)/' \
		-e 's/^(\[[^]]+\])[[:space:]]+(\+|-) (.*)-([^ -]+-[^ -]+)$/\1 \2 \3 (\4)/' \
		-e 's/^(.*) = (.*)-([^ -]+-[^ -]+) -> (.*)-([^ -]+-[^ -]+)$/\1 = \2 (\3 -> \5)/'
	} |
	sort -s -k1,2 |
	awk '{
		ts=substr($0,1,21)
		rest=substr($0,23)
		if(ts==prev) print rest
		else print $0
		prev=ts
	}' |
	sed -E '/---/! s/^\[[^]]+\] //' |
	awk '/--- /{if(sep&&has)print sep;sep=$0;has=0;next}{if(sep){print sep;sep=""};print;has=1}END{if(sep&&has)print sep}' |
	if (( color )); then
		sed -E \
		-e 's/(---.*)$/\x1b[37m\1\x1b[0m/' \
		-e 's/^(\+ .*)$/\x1b[32m\1\x1b[0m/' \
		-e 's/^(= .*)$/\x1b[33m\1\x1b[0m/' \
		-e 's/^(- .*)$/\x1b[31m\1\x1b[0m/' \
		-e 's/( \+ .*)$/\x1b[32m\1\x1b[0m/' \
		-e 's/( = .*)$/\x1b[33m\1\x1b[0m/' \
		-e 's/( - .*)$/\x1b[31m\1\x1b[0m/'
	else
		cat
	fi
}

# Remove duplicate entries by operation and package name.
# f keeps the first occurrence; l keeps the last.
_rp_filter_duplicates() {
	local filter=${1:-}
	local mode

	if [[ $filter == *l* ]]; then
		mode=l
	elif [[ $filter == *f* ]]; then
		mode=f
	else
		cat
		return
	fi

	awk -v mode="$mode" '
	{
		lines[NR] = $0

		plain = $0
		gsub(/\033\[[0-9;]*m/, "", plain)

		key = ""
		if (plain ~ /^[[:space:]]*[+=-][[:space:]]+/) {
			op = plain
			sub(/^[[:space:]]*/, "", op)
			op = substr(op, 1, 1)

			pkg = plain
			sub(/^[[:space:]]*[+=-][[:space:]]+/, "", pkg)
			sub(/[[:space:]].*$/, "", pkg)

			key = op " " pkg
		}

		keys[NR] = key

		if (key != "") {
			if (!(key in first))
				first[key] = NR

			last[key] = NR
		}
	}

	END {
		for (i = 1; i <= NR; i++) {
			key = keys[i]

			if (key == "" ||
			    (mode == "f" && first[key] == i) ||
			    (mode == "l" && last[key] == i))
				print lines[i]
		}
	}'
}

# Keep only entries for packages currently installed by pacman.
# Historical +, - and = entries are retained if the package
# is currently installed, regardless of the operation.
_rp_filter_installed() {
	local filter=${1:-}
	local installed_file
	local status

	[[ $filter == *i* ]] || {
		cat
		return
	}

	installed_file=$(mktemp) || return 1

	if ! pacman -Qq > "$installed_file"; then
		rm -f "$installed_file"
		return 1
	fi

	awk -v installed_file="$installed_file" '
		FILENAME == installed_file {
			installed[$1] = 1
			next
		}

		{
			plain = $0
			gsub(/\033\[[0-9;]*m/, "", plain)

			if (plain !~ /^[[:space:]]*[+=-][[:space:]]+/) {
				print
				next
			}

			pkg = plain
			sub(/^[[:space:]]*[+=-][[:space:]]+/, "", pkg)
			sub(/[[:space:]].*$/, "", pkg)

			if (pkg in installed)
				print
		}
	' "$installed_file" -

	status=$?
	rm -f "$installed_file"
	return "$status"
}

# Apply all requested filters.
_rp_apply_filters() {
	local filter=${1:-}

	_rp_filter_duplicates "$filter" |
		_rp_filter_installed "$filter"
}

_rp_blocks() {
	local mode=$1
	local color=${2:-1}
	local filter=${3:-}

	case $mode in
		c)
			rp "$color" | _rp_apply_filters "$filter" | sed '/= /d'
			;;
		u)
			rp "$color" | _rp_apply_filters "$filter" | sed -E '/ \+ /d; / - /d'
			;;
		a)
			rp "$color" | _rp_apply_filters "$filter"
			;;
		*)
			return 1
			;;
	esac |
	awk '
		/--- / {
			if (block != "" && has)
				blocks[++n]=block

			block=$0 ORS
			has=0
			next
		}

		{
			block=block $0 ORS

			if ($0 ~ /\+ / || $0 ~ /= / || $0 ~ /- /)
				has=1
		}

		END {
			if (block != "" && has)
				blocks[++n]=block

			for (i=n; i>=1; i--)
				printf "%s", blocks[i]
		}
	' | sed 's/--- //'
}

_rp_fzf() {
	local mode=$1
	local number=$2
	local color=${3:-1}
	local filter=${4:-}

	local output
	local display_file
	local search_file
	local search_mode_file
	local first_match_bind
	local next_match_bind
	local prev_match_bind
	local toggle_filter_bind

	output=$(_rp_blocks "$mode" "$color" "$filter") || return 1

	if [[ $number == 1 ]]; then
		output=$(printf '%s\n' "$output" | awk '{print NR " " $0}')
	fi

	display_file=$(mktemp) || return 1
	search_file=$(mktemp) || {
		rm -f "$display_file"
		return 1
	}
	search_mode_file=$(mktemp) || {
		rm -f "$display_file" "$search_file"
		return 1
	}

	printf '%s\n' "$output" > "$display_file"

	printf '%s\n' "$output" |
		sed -E $'s/\\x1b\\[[0-9;]*m//g' > "$search_file"

	printf '%s\n' 'jump' > "$search_mode_file"

	export PHN_DISPLAY_FILE="$display_file"
	export PHN_SEARCH_FILE="$search_file"
	export PHN_SEARCH_MODE_FILE="$search_mode_file"

	first_match_bind='change:transform:
		mode=$(cat "$PHN_SEARCH_MODE_FILE" 2>/dev/null || printf jump)

		if [[ "$mode" == "filter" ]]; then
			exit
		fi

		if [[ -z "$FZF_QUERY" ]]; then
			exit
		fi

		n=$(grep -niF -- "$FZF_QUERY" "$PHN_SEARCH_FILE" |
			head -n1 |
			cut -d: -f1)

		if [[ -n "$n" ]]; then
			printf "pos(%s)\n" "$n"
		fi
	'

	next_match_bind='ctrl-n:transform:
		mode=$(cat "$PHN_SEARCH_MODE_FILE" 2>/dev/null || printf jump)

		if [[ "$mode" == "filter" ]]; then
			printf "down\n"
			exit
		fi

		if [[ -z "$FZF_QUERY" ]]; then
			printf "down\n"
			exit
		fi

		n=$(grep -niF -- "$FZF_QUERY" "$PHN_SEARCH_FILE" |
			cut -d: -f1 |
			awk -v pos="$FZF_POS" "
				NR == 1 { first = \$1 }
				\$1 > pos { print; found = 1; exit }
				{ last = \$1 }
				END {
					if (!found && first != \"\")
						print first
				}
			" |
			head -n1)

		if [[ -n "$n" ]]; then
			printf "pos(%s)\n" "$n"
		fi
	'

	prev_match_bind='ctrl-p:transform:
		mode=$(cat "$PHN_SEARCH_MODE_FILE" 2>/dev/null || printf jump)

		if [[ "$mode" == "filter" ]]; then
			printf "up\n"
			exit
		fi

		if [[ -z "$FZF_QUERY" ]]; then
			printf "up\n"
			exit
		fi

		n=$(grep -niF -- "$FZF_QUERY" "$PHN_SEARCH_FILE" |
			cut -d: -f1 |
			awk -v pos="$FZF_POS" "
				\$1 < pos { prev = \$1 }
				{ last = \$1 }
				END {
					if (prev != \"\")
						print prev
					else if (last != \"\")
						print last
				}
			" |
			head -n1)

		if [[ -n "$n" ]]; then
			printf "pos(%s)\n" "$n"
		fi
	'

	toggle_filter_bind='ctrl-r:transform:
		mode=$(cat "$PHN_SEARCH_MODE_FILE" 2>/dev/null || printf jump)

		if [[ "$mode" == "filter" ]]; then
			printf "%s\n" jump > "$PHN_SEARCH_MODE_FILE"
			printf "disable-search+reload-sync(cat \"$PHN_DISPLAY_FILE\")+change-ghost([C-n next · C-p prev · C-r restrict:OFF])+first\n"
		else
			printf "%s\n" filter > "$PHN_SEARCH_MODE_FILE"
			printf "reload-sync(cat \"$PHN_DISPLAY_FILE\")+enable-search+change-ghost([C-n next · C-p prev · C-r restrict:ON])+wait+first\n"
		fi
	'

	trap 'rm -f "$PHN_DISPLAY_FILE" "$PHN_SEARCH_FILE" "$PHN_SEARCH_MODE_FILE"; unset PHN_DISPLAY_FILE PHN_SEARCH_FILE PHN_SEARCH_MODE_FILE' RETURN

	local selected

	selected=$(printf '%s\n' "$output" |
		fzf --exact --ansi -e --no-sort --height=100% \
			--disabled \
			--scroll-off=3 \
			--prompt '> ' \
			--ghost '[Ctrl-n next · C-p prev · C-r restrict:OFF]' \
			--info hidden \
			--bind "$first_match_bind" \
			--bind "$next_match_bind" \
			--bind "$prev_match_bind" \
			--bind "$toggle_filter_bind" \
			--preview 'cmd=$(echo {} | sed "s/^[[:space:]]*[0-9]*[[:space:]]*//;s/^\[[^]]*\][[:space:]]*//;s/^'\''//;s/'\''$//"); p=$(echo "$cmd" | awk "\$1 == \"+\" || \$1 == \"=\" || \$1 == \"-\" {print \$2; exit}"); if [[ -n "$p" ]]; then out=$(pacman -Sii "$p" 2>/dev/null) && printf "%s\n" "$out" || printf "%s\n" "$cmd"; else printf "%s\n" "$cmd"; fi' \
			--preview-window=right:65%) || return

	local clean
	clean=$(printf '%s\n' "$selected" |
		sed -E $'s/\\x1b\\[[0-9;]*m//g; s/^[[:space:]]*[0-9]+[[:space:]]+//; s/^\\[[^]]+\\][[:space:]]*//; s/^[[:space:]]+//')

	local clipboard_text
	if [[ $clean =~ ^[+=-][[:space:]]+ ]]; then
		clipboard_text=$(printf '%s\n' "$clean" | awk '{print $2}')
	else
		clipboard_text=$(printf '%s\n' "$clean" | sed -E "s/^'//; s/'$//")
	fi

	if command -v wl-copy >/dev/null 2>&1; then
		printf '%s\n' "$clipboard_text" | wl-copy
	elif command -v xsel >/dev/null 2>&1; then
		printf '%s\n' "$clipboard_text" | xsel --clipboard --input
	fi
}

phn() {
	local mode=a
	local dump=0
	local number=0
	local color=1
	local filter=

	for arg in "$@"; do
		case $arg in
			c|change)
				mode=c
				;;
			u|update)
				mode=u
				;;
			d|dump)
				dump=1
				;;
			n|number)
				number=1
				;;
			m|monochrome)
				color=0
				;;
			f|first)
				filter="${filter//[fl]/}f"
				;;
			l|last)
				filter="${filter//[fl]/}l"
				;;
			i|installed)
				[[ $filter == *i* ]] || filter="${filter}i"
				;;
			-h|--help)
				cat <<'EOF'
Usage:

  phn [MODE] [MODIFIERS]

Modes:
  c | change          changes (+ / -)
  u | update          updates (=)
  d | dump            dump (raw output)
  <empty>             all (interactive)

Modifiers:
  n | number          add line numbers
  m | monochrome      monochrome output
  f | first           remove duplicates, keep the first occurrence
  l | last            remove duplicates, keep the last occurrence
  i | installed       show only packages currently installed

Examples:
  phn
  phn c
  phn u
  phn d
  phn n
  phn f
  phn l
  phn i
  phn fi
  phn li
  phn dfi
  phn dli
  phn dim
  phn unm

Options:
  -h, --help          show this help
  -v, --version       show version
EOF
				return 0
				;;
			--version|-v)
				printf '%s\n' 'phn 1.0'
				return 0
				;;
			*)
				if [[ $arg =~ ^[cudnmfli]+$ ]]; then
					for ((i=0; i<${#arg}; i++)); do
						case ${arg:i:1} in
							c)
								mode=c
								;;
							u)
								mode=u
								;;
							d)
								dump=1
								;;
							n)
								number=1
								;;
							m)
								color=0
								;;
							f)
								filter="${filter//[fl]/}f"
								;;
							l)
								filter="${filter//[fl]/}l"
								;;
							i)
								[[ $filter == *i* ]] || filter="${filter}i"
								;;
						esac
					done
					continue
				fi

				printf 'phn: unknown argument: %s\n' "$arg" >&2
				phn --help
				return 2
				;;
		esac
	done

	if (( dump )); then
		case $mode in
			c)
				output=$(rp "$color" | _rp_apply_filters "$filter" | sed '/= /d')
				;;
			u)
				output=$(rp "$color" | _rp_apply_filters "$filter" | sed -E '/ \+ /d; / - /d')
				;;
			a)
				output=$(rp "$color" | _rp_apply_filters "$filter")
				;;
		esac

		if (( number )); then
			printf '%s\n' "$output" | awk '{print NR " " $0}' | sed 's/--- //'
		else
			printf '%s\n' "$output" | sed 's/--- //'
		fi
		return
	fi

	_rp_fzf "$mode" "$number" "$color" "$filter"
}

phn "$@"
